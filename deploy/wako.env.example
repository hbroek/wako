# /etc/wako/wako.env, read by the systemd unit. Every setting is optional.
WAKO_ADDR=127.0.0.1:8888
WAKO_PUBLIC_URL=https://wiki.example.com
WAKO_TRUSTED_PROXIES=127.0.0.1/32
WAKO_ALLOWED_HOSTS=wiki.example.com
WAKO_SITE_NAME=Wako
# Set once to choose the first administrator's password (otherwise one is generated and logged once):
# WAKO_ADMIN_PASSWORD=
